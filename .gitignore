# ==============================================================================
# Rust LLM Gateway & Semantic Router - Production .gitignore
# Security Policy: Zero-Leak / Defense-in-Depth
# ==============================================================================

# ==============================================================================
# Rust & Cargo Build Artifacts
# ==============================================================================
/target/
**/*.rs.bk
*.pdb
*.profraw
*.profdata
*.llvmcovraw

# Cargo build locks & crates cache (Cargo.lock is tracked for binaries; uncomment if library)
# Cargo.lock
cargo-timing.html

# ==============================================================================
# Security & Sensitive Credentials (Zero-Leak Policy)
# ==============================================================================
# Environment variables and secrets
.env
.env.*
.envrc
*.env
# Safe exceptions: strictly track examples and templates only
!.env.example
!.env.template
!.env.sample

# Private keys, certificates and key stores
*.pem
*.key
*.pkcs12
*.p12
*.pfx
*.keystore
*.cer
*.crt
*.der
*.csr
*.asc
secring.*

# SSH & GPG keys
id_rsa
id_rsa.pub
id_ed25519
id_ed25519.pub
id_ecdsa
id_ecdsa.pub
known_hosts
authorized_keys

# Cloud, Platform & Service Account Credentials
*credentials.json
*service-account*.json
gcp-key*.json
aws_credentials
.aws/
.azure/
.gcloud/
kubeconfig*
*.kubeconfig
.kube/
.netrc
.npmrc
.pypirc

# Secret configuration files & overrides
secrets.toml
secrets.yaml
secrets.json
*.secret
*.secrets
config/local.toml
config/production.toml
config/staging.toml
config/secrets.toml
config/*.local.toml
*.override.toml
*.override.yaml
*.override.json

# ==============================================================================
# Logs, Diagnostic & Crash Dumps
# ==============================================================================
*.log
logs/
log/
*.dmp
*.dump
*.stackdump
core
core.*
hs_err_pid*.log

# ==============================================================================
# Performance, Profiling & Benchmarking Outputs
# ==============================================================================
benchmarks/output/
tests/load_test_summary.json
flamegraph.svg
perf.data*
heaptrack.*
valgrind.out*
callgrind.out*
massif.out*

# Code coverage reports
coverage/
tarpaulin-report*
cobertura.xml
lcov.info
*.lcov

# ==============================================================================
# Temporary Files, Caches & Databases
# ==============================================================================
*.tmp
*.temp
*.bak
*.swp
*.swo
*~
.cache/
*.sqlite
*.sqlite3
*.db
*.db-shm
*.db-wal
*.rdb

# ==============================================================================
# Node.js / Load Testing Tooling (k6, Artillery, Node)
# ==============================================================================
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
.loadtest-results/

# ==============================================================================
# Containers & Local Development Overrides
# ==============================================================================
docker-compose.override.yml
docker-compose.override.yaml
.docker/

# ==============================================================================
# IDEs, Editors & Developer Workspace Settings
# ==============================================================================
# Visual Studio Code
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
*.code-workspace

# JetBrains / IntelliJ / CLion / RustRover
.idea/
*.iml
*.iws
*.ipr
cmake-build-*/

# Vim / Emacs / Sublime Text
.#*
#*#
*.sublime-project
*.sublime-workspace

# ==============================================================================
# Operating System Artifacts
# ==============================================================================
# macOS
.DS_Store
.AppleDouble
.LSOverride
._*
.Spotlight-V100
.Trashes

# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
Desktop.ini
$RECYCLE.BIN/
*.lnk

# Linux
.directory
.Trash-*

# ==============================================================================
# Documentation, Licenses & Whitelisted Assets (Never Ignore)
# ==============================================================================
!README*
!README.md
!docs/**
!LICENSE*
!CHANGELOG*
!CONTRIBUTING*
