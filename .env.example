# ==============================================================================
# Rust LLM Gateway & Semantic Router - Environment Variables Template
# Copy this file to .env or .env.local for local development.
# NEVER commit the actual .env file or production secrets to source control.
# ==============================================================================

# Server Configuration
APP__SERVER__HOST=0.0.0.0
APP__SERVER__PORT=8080
APP__SERVER__MAX_BODY_BYTES=4194304

# Authentication (Comma-separated valid API keys)
APP__AUTH__VALID_API_KEYS=dev-key-1,dev-key-2

# Rate Limiting
APP__RATE_LIMIT__DEFAULT_RPM=60
APP__RATE_LIMIT__DEFAULT_TPM=90000

# Cache Configuration
APP__CACHE__EXACT_MAX_ENTRIES=50000
APP__CACHE__EXACT_TTL_SECONDS=3600
APP__CACHE__SEMANTIC_ENABLED=false
APP__CACHE__SEMANTIC_THRESHOLD=0.96

# Circuit Breaker Configuration
APP__CIRCUIT_BREAKER__FAILURE_THRESHOLD=3
APP__CIRCUIT_BREAKER__COOLDOWN_SECONDS=10
APP__CIRCUIT_BREAKER__HALF_OPEN_MAX_CALLS=1

# Upstream Provider API Keys
# GROQ_API_KEY=gsk_...
# OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...
